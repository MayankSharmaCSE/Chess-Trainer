# Copy to .env and edit. Never commit .env.
JWT_SECRET=dev-only-change-me
JWT_EXPIRE_DAYS=7
# SQLite default (file created in backend/). Postgres example:
# DATABASE_URL=postgresql://user:pass@localhost:5432/chesslens
DATABASE_URL=sqlite:///./data.db
FRONTEND_URL=http://localhost:3000
# US-009 Option B: LLM grounded coaching. Leave the key empty to run without
# AI coaching (rules-v1 fallback). Any OpenAI-compatible endpoint works.
# LLM_PROVIDER=openai-compatible
# LLM_API_KEY=sk-...-paste-your-key-here
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_TIMEOUT_S=20
# OpenRouter only: backups tried in order when LLM_MODEL errors (e.g. 429 on
# shared :free pools). Comma-separated.
# LLM_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free
# LLM_MAX_TOKENS=150
# Thinking models (Qwen 3.x, GPT-OSS, Gemini 3): their thinking can eat the token
# budget and leave an empty reply. Turn it down and give some headroom:
# LLM_REASONING_EFFORT=none   # Ollama/Groq Qwen; use "low" for GPT-OSS or Gemini 3
# LLM_MAX_TOKENS=1024

# Password reset emails (Forgot password). Render's FREE tier blocks SMTP, so use
# Brevo's HTTP API there (free 300/day): create an API key at brevo.com and use a
# sender address verified in Brevo. FRONTEND_URL above builds the reset link.
# Unset = console mode: emails are only written to the server log (dev only).
# BREVO_API_KEY=xkeysib-...
# MAIL_FROM_EMAIL=you@example.com
# MAIL_FROM_NAME=ChessLens
# Or SMTP (local / paid hosts): SMTP_HOST, SMTP_PORT=587, SMTP_USER, SMTP_PASSWORD
# MAIL_PROVIDER=brevo|smtp|console   (default: auto)
